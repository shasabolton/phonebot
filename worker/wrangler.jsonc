{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "phonebot-arcade-billing",
	"main": "src/index.js",
	"compatibility_date": "2026-08-17",
	"compatibility_flags": [
		"nodejs_compat"
	],
	"observability": {
		"enabled": true,
		"head_sampling_rate": 1
	},
	"vars": {
		"ALLOWED_ORIGINS": "https://shasabolton.github.io,http://localhost:8000",
		"GROQ_ALLOWED_MODELS": "openai/gpt-oss-20b,openai/gpt-oss-120b,qwen/qwen3.8-27b",
		"GROQ_ALLOWED_TRANSCRIBE_MODELS": "whisper-large-v3,whisper-large-v3-turbo",
		"GROQ_ALLOWED_SPEECH_MODELS": "canopylabs/orpheus-v1-english,canopylabs/orpheus-arabic-saudi",
		"GROQ_TRANSCRIBE_CENTS": "1",
		"GROQ_SPEECH_CENTS": "1",
		"GROQ_RATES_JSON": "{}",
		"GROQ_AUD_PER_USD": "1.5"
	},
	"d1_databases": [
		{
			"binding": "DB",
			"database_name": "phonebot-arcade",
			"database_id": "60c02bf8-f0a5-4b2b-b28d-3f74f77f3bf9",
			"migrations_dir": "migrations"
		}
	]
}